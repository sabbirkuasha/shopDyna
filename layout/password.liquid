{%- comment -%}
  Layout for the storefront password page.

  Shopify serves this layout instead of theme.liquid while password protection
  is enabled, so it deliberately omits the header, navigation, cart drawer, and
  footer — none of the store is meant to be reachable from here.
{%- endcomment -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="scroll-smooth motion-reduce:scroll-auto">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="{{ settings.accent_color }}">
    <title>{{ shop.name | escape }}</title>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/x-icon" href="{{ 'plannet.ico' | asset_url }}">
    {%- endif -%}
    {{ content_for_header }}
    {{ 'tailwind.output.css' | asset_url | stylesheet_tag: preload: true, media: 'all' }}
  </head>
  <body class="template-password min-h-screen bg-gray-50 text-gray-900">
    <a
      class="sr-only z-[200] focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:inline-flex focus:min-h-11 focus:items-center focus:rounded focus:bg-[var(--skip-link-bg,#7d1717)] focus:px-5 focus:py-2 focus:font-semibold focus:text-white focus:no-underline"
      href="#main"
      style="--skip-link-bg: {{ settings.accent_color }}"
    >
      Skip to content
    </a>
    <main id="main" tabindex="-1" class="focus:outline-none">
      {{ content_for_layout }}
    </main>
  </body>
</html>
