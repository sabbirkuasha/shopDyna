<!doctype html>
<html lang="en" class="scroll-smooth motion-reduce:scroll-auto">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script>
      try {
        if (sessionStorage.getItem('deshal-page-transition') === 'pending') {
          document.documentElement.classList.add('page-transition-active');
          window.setTimeout(() => document.documentElement.classList.remove('page-transition-active'), 2500);
        }
      } catch (error) {}
    </script>
    <style>
      @view-transition {
        navigation: auto;
      }
      ::view-transition-old(root) {
        animation: 260ms cubic-bezier(0.4, 0, 1, 1) both deshal-page-out;
      }
      ::view-transition-new(root) {
        animation: 420ms cubic-bezier(0, 0, 0.2, 1) both deshal-page-in;
      }
      @keyframes deshal-page-out {
        to {
          opacity: 0.82;
          transform: scale(0.995);
        }
      }
      @keyframes deshal-page-in {
        from {
          opacity: 0;
          transform: translateY(8px);
        }
      }
      .page-transition-active body {
        overflow: hidden;
      }
      .page-transition-active [data-page-transition] {
        opacity: 1 !important;
        transform: translateY(0) !important;
      }
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation-duration: 0.001ms;
        }
      }
    </style>
    <link rel="icon" href="{{ 'plannet.ico' | asset_url }}" type="image/x-icon">
    {{ content_for_header }}
    {{ 'tailwind.output.css' | asset_url | stylesheet_tag: preload: true, media: 'all' }}
    <title>{{ page_title }}</title>
  </head>
  <body class="template-{{ template.name | handle }}">
    <div
      class="pointer-events-none fixed inset-0 z-[100] grid place-items-center bg-gradient-to-br from-[#5e1010] via-[#7d1717] to-[#3d0909] opacity-0"
      aria-hidden="true"
      data-page-transition
    >
      <img
        class="w-28 brightness-0 invert sm:w-36"
        src="{{ 'DeshalMain.png' | asset_url }}"
        alt=""
        width="160"
        height="64"
      >
    </div>
    {% section 'banner' %}
    <div class="sticky top-0 z-40">
      {% section 'navbar' %}
    </div>
    <main id="main" role="main">
      {{ content_for_layout }}
    </main>
    {% section 'cart-drawer' %}
    {% section 'footer' %}
    <script src="{{ 'gsap.min.js' | asset_url }}" defer></script>
    <script src="{{ 'ScrollTrigger.min.js' | asset_url }}" defer></script>
    <script src="{{ 'animations.js' | asset_url }}" defer></script>
    <script src="{{ 'storefront.js' | asset_url }}" defer></script>
  </body>
</html>
