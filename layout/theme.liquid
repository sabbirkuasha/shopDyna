<!doctype html>
{%- liquid
  assign rtl_locales = 'ar,arc,ckb,dv,fa,ha,he,khw,ks,ps,sd,ur,uz-AF,yi'
  assign text_direction = 'ltr'
  if rtl_locales contains request.locale.iso_code
    assign text_direction = 'rtl'
  endif
-%}
<html
  lang="{{ request.locale.iso_code }}"
  dir="{{ text_direction }}"
  class="scroll-smooth motion-reduce:scroll-auto"
>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="{{ settings.accent_color }}">
    <script>
      try {
        if (sessionStorage.getItem('deshal-page-transition') === 'pending') {
          document.documentElement.classList.add('page-transition-active');
          window.setTimeout(() => document.documentElement.classList.remove('page-transition-active'), 2500);
        }
      } catch (error) {}
    </script>
    <style>
      @view-transition {
        navigation: auto;
      }
      ::view-transition-old(root) {
        animation: 260ms cubic-bezier(0.4, 0, 1, 1) both deshal-page-out;
      }
      ::view-transition-new(root) {
        animation: 420ms cubic-bezier(0, 0, 0.2, 1) both deshal-page-in;
      }
      @keyframes deshal-page-out {
        to {
          opacity: 0.82;
          transform: scale(0.995);
        }
      }
      @keyframes deshal-page-in {
        from {
          opacity: 0;
          transform: translateY(8px);
        }
      }
      .page-transition-active body {
        overflow: hidden;
      }
      .page-transition-active [data-page-transition] {
        opacity: 1 !important;
        transform: translateY(0) !important;
      }
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation-duration: 0.001ms;
        }
      }
    </style>
    {% render 'meta-tags' %}
    {{ content_for_header }}
    {{ 'tailwind.output.css' | asset_url | stylesheet_tag: preload: true, media: 'all' }}
    {% render 'structured-data' %}
  </head>
  <body class="template-{{ template.name | handle }}">
    <a
      class="sr-only z-[200] focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:inline-flex focus:min-h-11 focus:items-center focus:rounded focus:bg-[var(--skip-link-bg,#7d1717)] focus:px-5 focus:py-2 focus:font-semibold focus:text-white focus:no-underline focus:outline-2 focus:outline-offset-2 focus:outline-white"
      href="#main"
      style="--skip-link-bg: {{ settings.accent_color }}"
    >
      Skip to content
    </a>
    <div class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-live-region></div>
    <div
      class="pointer-events-none fixed inset-0 z-[100] grid place-items-center bg-gradient-to-br from-[#5e1010] via-[#7d1717] to-[#3d0909] opacity-0"
      aria-hidden="true"
      data-page-transition
    >
      <img
        class="w-28 brightness-0 invert sm:w-36"
        src="{{ 'DeshalMain.png' | asset_url }}"
        alt=""
        width="160"
        height="64"
      >
    </div>
    {% section 'banner' %}
    <div class="sticky top-0 z-40">
      {% section 'navbar' %}
    </div>
    <main id="main" tabindex="-1" class="focus:outline-none">
      {{ content_for_layout }}
    </main>
    {% section 'cart-drawer' %}
    {% section 'footer' %}
    <script src="{{ 'gsap.min.js' | asset_url }}" defer></script>
    <script src="{{ 'ScrollTrigger.min.js' | asset_url }}" defer></script>
    <script src="{{ 'animations.js' | asset_url }}" defer></script>
    <script src="{{ 'storefront.js' | asset_url }}" defer></script>
  </body>
</html>
