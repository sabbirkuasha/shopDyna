{
  "name": "shopdyna",
  "version": "1.0.0",
  "description": "Dynamic Shopify Theme",
  "main": "index.js",
  "scripts": {
    "test": "npm run validate",
    "validate": "node scripts/validate-theme.mjs",
    "format": "prettier --write \"**/*.{liquid,json,css,js,mjs}\"",
    "format:check": "prettier --check \"**/*.{liquid,json,css,js,mjs}\"",
    "build": "npx @tailwindcss/cli -i ./assets/tailwind.input.css -o ./assets/tailwind.output.css --minify",
    "check": "npm run validate && npm run format:check",
    "theme:check": "shopify theme check",
    "dev": "concurrently \"shopify theme dev -e development\" \"npx @tailwindcss/cli -i ./assets/tailwind.input.css -o ./assets/tailwind.output.css --watch\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sabbirkuasha/shopDyna.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/sabbirkuasha/shopDyna/issues"
  },
  "homepage": "https://github.com/sabbirkuasha/shopDyna#readme",
  "dependencies": {
    "@tailwindcss/vite": "^4.1.10",
    "gsap": "^3.13.0",
    "tailwindcss": "^4.1.10"
  },
  "devDependencies": {
    "@shopify/prettier-plugin-liquid": "^1.9.3",
    "@tailwindcss/cli": "^4.1.10",
    "concurrently": "^9.1.2",
    "daisyui": "^5.0.43",
    "prettier": "^3.5.3"
  }
}
