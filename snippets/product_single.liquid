{% comment %}
  Deshal product card.
  Accepts product_card_product: Product drop.
{% endcomment %}

{% liquid
  assign primary_image = product_card_product.featured_image
  assign secondary_image = product_card_product.images[1]
  assign product_url = product_card_product.url | within: collection
  assign is_new = false
  if product_card_product.tags contains 'New' or product_card_product.tags contains 'new'
    assign is_new = true
  endif
%}

<article class="group relative w-full overflow-hidden rounded-md bg-white shadow-sm transition-shadow hover:shadow-lg">
  <button
    class="absolute left-2 top-2 z-30 grid size-10 cursor-pointer place-items-center rounded-full border-0 bg-white/90 text-gray-700 shadow hover:text-red-700"
    type="button"
    aria-label="Add {{ product_card_product.title | escape }} to favourites"
    aria-pressed="false"
    data-favorite-toggle
    data-product='{"handle":{{ product_card_product.handle | json }},"title":{{ product_card_product.title | json }},"url":{{ product_card_product.url | json }},"image":{{ product_card_product.featured_image | image_url: width: 700 | json }},"price":{{ product_card_product.price | money | json }}}'
  >
    <svg class="size-5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
      <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.9-8.6a5.5 5.5 0 0 0-.1-7.8Z"/>
    </svg>
  </button>
  <a class="block" href="{{ product_url }}" aria-label="{{ product_card_product.title | escape }}">
    <figure class="relative m-0 aspect-[4/5] overflow-hidden bg-gray-100">
      {% if is_new -%}
        <span class="absolute right-2 top-2 z-20 bg-red-700 px-3 py-2 text-xs font-medium uppercase text-white"
          >New</span
        >
      {%- endif %}
      {% unless product_card_product.available -%}
        <span class="absolute left-2 top-2 z-20 bg-gray-800 px-3 py-2 text-xs font-medium uppercase text-white"
          >Sold out</span
        >
      {%- endunless %}

      {% if primary_image != blank %}
        {{
          primary_image
          | image_url: width: 1200
          | image_tag:
            class: 'absolute inset-0 z-10 h-full w-full object-cover opacity-100 transition-opacity duration-300 ease-in group-hover:opacity-0',
            widths: '320, 480, 640, 800, 1000, 1200',
            sizes: '(min-width: 1024px) 25vw, (min-width: 768px) 33vw, (min-width: 640px) 50vw, 100vw',
            loading: 'lazy',
            alt: primary_image.alt
        }}
        {% if secondary_image != blank %}
          {{
            secondary_image
            | image_url: width: 1200
            | image_tag:
              class: 'h-full w-full object-cover',
              widths: '320, 480, 640, 800, 1000, 1200',
              sizes: '(min-width: 1024px) 25vw, (min-width: 768px) 33vw, (min-width: 640px) 50vw, 100vw',
              loading: 'lazy',
              alt: secondary_image.alt
          }}
        {% else %}
          {{
            primary_image
            | image_url: width: 1200
            | image_tag:
              class: 'h-full w-full object-cover',
              widths: '320, 480, 640, 800, 1000, 1200',
              sizes: '(min-width: 1024px) 25vw, (min-width: 768px) 33vw, (min-width: 640px) 50vw, 100vw',
              loading: 'lazy',
              alt: primary_image.alt
          }}
        {% endif %}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'h-full w-full object-cover text-gray-300' }}
      {% endif %}
    </figure>

    <div class="relative z-10 flex min-h-16 items-center justify-between gap-3 bg-white px-2 py-2">
      <div class="min-w-0">
        <h2 class="m-0 truncate text-sm font-bold text-black sm:text-base">
          {{ product_card_product.title | escape }}
        </h2>
        <p class="m-0 mt-0.5 text-sm text-black sm:text-base">
          {% if product_card_product.compare_at_price > product_card_product.price %}
            <span>{{ product_card_product.price | money }}</span>
            <span class="ml-1 text-red-700 line-through">{{ product_card_product.compare_at_price | money }}</span>
          {% else %}
            <span>{{ product_card_product.price | money }}</span>
          {% endif %}
        </p>
      </div>
      <span
        class="grid size-9 shrink-0 place-items-center text-gray-800 transition-colors group-hover:text-[var(--collection-accent)]"
        aria-hidden="true"
      >
        <svg class="size-7 fill-current" viewBox="0 0 16 16">
          <path fill-rule="evenodd" d="M10.85 8.15a.5.5 0 0 1 0 .7l-3 3a.5.5 0 0 1-.7 0l-1.5-1.5a.5.5 0 0 1 .7-.7l1.15 1.14 2.65-2.64a.5.5 0 0 1 .7 0Z"/>
          <path d="M8 1a2.5 2.5 0 0 1 2.5 2.5V4H15v10a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V4h4.5v-.5A2.5 2.5 0 0 1 8 1Zm1.5 3v-.5a1.5 1.5 0 0 0-3 0V4h3ZM2 5v9a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V5H2Z"/>
        </svg>
      </span>
    </div>
  </a>
</article>
