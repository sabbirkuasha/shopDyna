<section class="w-full bg-white" aria-label="{{ section.settings.accessibility_label | escape }}">
  {% if section.settings.link != blank %}<a class="block" href="{{ section.settings.link }}">{% endif %}
  <picture>
    {% if section.settings.mobile_image != blank %}
      <source media="(max-width: 767px)" srcset="{{ section.settings.mobile_image | image_url: width: 1200 }}">
    {% else %}
      <source media="(max-width: 767px)" srcset="{{ 'home-eid-mobile.jpg' | asset_url }}">
    {% endif %}
    {% if section.settings.desktop_image != blank %}
      {{
        section.settings.desktop_image
        | image_url: width: 2560
        | image_tag:
          class: 'block h-auto w-full object-cover',
          widths: '960, 1280, 1600, 1920, 2560',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: section.settings.accessibility_label
      }}
    {% else %}
      <img
        class="block h-auto w-full object-cover"
        src="{{ 'home-eid-desktop.jpg' | asset_url }}"
        alt="{{ section.settings.accessibility_label | escape }}"
        width="1920"
        height="850"
        loading="eager"
        fetchpriority="high"
      >
    {% endif %}
  </picture>
  {% if section.settings.link != blank %}</a>{% endif %}
</section>

{% schema %}
{
  "name": "Home hero",
  "settings": [
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop image", "info": "Recommended: 1920 × 850 px" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image", "info": "Recommended: 855 × 654 px" },
    { "type": "url", "id": "link", "label": "Campaign link" },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Image description",
      "default": "Deshal seasonal collection"
    }
  ],
  "presets": [{ "name": "Home hero" }]
}
{% endschema %}
