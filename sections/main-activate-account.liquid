{%- comment -%}
  Account activation for classic customer accounts.

  Shopify links here from the account invitation email. The `activate_customer_password`
  form tag posts both the password and the decline action.
{%- endcomment -%}

<section class="bg-gray-50 py-12 sm:py-20" style="--account-accent: {{ section.settings.accent_color }}">
  <div class="mx-auto max-w-md px-4">
    <div class="rounded-md bg-white p-6 shadow-xl sm:p-10">
      <div class="text-center">
        <img
          class="mx-auto h-16 w-auto"
          src="{{ 'DeshalMain.png' | asset_url }}"
          width="160"
          height="64"
          alt="{{ shop.name | escape }}"
        >
        <h1 class="mt-5 text-3xl font-bold uppercase text-[var(--account-accent)]">Activate account</h1>
        <p class="mt-2 text-gray-500">Choose a password to finish setting up your account.</p>
      </div>

      {%- form 'activate_customer_password', class: 'mt-8 space-y-5' -%}
        {%- if form.errors -%}
          <div class="border border-red-200 bg-red-50 p-4 text-sm text-red-700" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div>
          <label class="mb-2 block text-sm font-medium" for="ActivatePassword">Password</label>
          <input
            class="h-12 w-full border border-gray-300 px-4 outline-none focus:border-[var(--account-accent)]"
            id="ActivatePassword"
            name="customer[password]"
            type="password"
            autocomplete="new-password"
            required
          >
        </div>
        <div>
          <label class="mb-2 block text-sm font-medium" for="ActivatePasswordConfirm">Confirm password</label>
          <input
            class="h-12 w-full border border-gray-300 px-4 outline-none focus:border-[var(--account-accent)]"
            id="ActivatePasswordConfirm"
            name="customer[password_confirmation]"
            type="password"
            autocomplete="new-password"
            required
          >
        </div>

        <button
          class="h-12 w-full cursor-pointer border-0 bg-[var(--account-accent)] font-semibold uppercase text-white hover:brightness-110"
          type="submit"
        >
          Activate account
        </button>
        <button
          class="h-12 w-full cursor-pointer border border-gray-400 bg-white font-semibold uppercase"
          name="decline"
          type="submit"
        >
          Decline invitation
        </button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Activate account",
  "settings": [{ "type": "color", "id": "accent_color", "label": "Accent color", "default": "#7d1717" }]
}
{% endschema %}
