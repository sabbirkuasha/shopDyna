{% if section.settings.message_bar %}
  <div class="relative z-50 flex min-h-8 w-full items-center justify-center bg-slate-800 px-10 py-1.5 text-center text-xs tracking-wide text-white sm:text-sm">
    <p class="m-0">{{ section.settings.message_text }}</p>
  </div>
{% endif %}

{% schema %}
{
  "name": "Message Bar",

  "settings": [
    {
      "type": "checkbox",
      "id": "message_bar",
      "label": "Message Bar Top",
      "default": false
    },
    {
      "type": "text",
      "id": "message_text",
      "label": "This is a default message bar text"
    }
  ],
  "presets": [
    {
      "name": "Message Bar"
    }
  ]
}
{% endschema %}
