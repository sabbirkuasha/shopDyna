{% liquid
  assign sort_by = collection.sort_by | default: collection.default_sort_by

  assign active_filter_count = 0
  for filter in collection.filters
    case filter.type
      when 'price_range'
        if filter.min_value.value != null or filter.max_value.value != null
          assign active_filter_count = active_filter_count | plus: 1
        endif
      else
        assign active_filter_count = active_filter_count | plus: filter.active_values.size
    endcase
  endfor

  assign category_navigation = section.settings.category_menu
  assign category_links = blank
  assign related_links = blank
  assign related_title = blank
  assign related_url = blank
  assign parent_title = blank
  assign parent_url = blank
  assign grandparent_title = blank
  assign grandparent_url = blank
  for parent_link in category_navigation.links
    if parent_link.type == 'collection_link' and parent_link.object.handle == collection.handle
      assign category_links = parent_link.links
    endif
    for child_link in parent_link.links
      if child_link.type == 'collection_link' and child_link.object.handle == collection.handle
        assign related_links = child_link.links
        assign related_title = child_link.title
        assign related_url = child_link.url
        assign parent_title = parent_link.title
        assign parent_url = parent_link.url
      endif
      for grandchild_link in child_link.links
        if grandchild_link.type == 'collection_link' and grandchild_link.object.handle == collection.handle
          assign related_links = child_link.links
          assign related_title = child_link.title
          assign related_url = child_link.url
          assign parent_title = child_link.title
          assign parent_url = child_link.url
          assign grandparent_title = parent_link.title
          assign grandparent_url = parent_link.url
        endif
      endfor
    endfor
  endfor
%}

<section class="w-full bg-white text-gray-900" style="--collection-accent: {{ section.settings.accent_color }};">
  {% if category_links != blank %}
    {% if section.settings.show_category_heading %}
      <header class="flex min-h-20 items-center justify-center bg-gray-200 px-5 py-5 uppercase md:min-h-24">
        <h1 class="m-0 text-center text-4xl font-bold tracking-tight text-[var(--collection-accent)] md:text-6xl">
          {{ collection.title | escape }}
        </h1>
      </header>
    {% endif %}

    {% if section.settings.show_description and collection.description != blank %}
      <div class="mx-auto max-w-4xl px-5 py-7 text-center leading-7 text-gray-600 [&_p]:m-0">
        {{ collection.description }}
      </div>
    {% endif %}

    <div class="grid grid-cols-2 content-center gap-1 px-1 py-4 md:gap-4 md:px-4 lg:grid-cols-3">
      {% for child_link in category_links %}
        {% liquid
          assign card_image = blank
          if child_link.type == 'collection_link'
            assign card_image = child_link.object.image
            if card_image == blank and child_link.object.products.first.featured_image != blank
              assign card_image = child_link.object.products.first.featured_image
            endif
          endif
        %}
        <article class="group relative m-auto w-full overflow-hidden bg-gray-100">
          <a class="block" href="{{ child_link.url }}">
            {% if card_image != blank %}
              {{
                card_image
                | image_url: width: 1600
                | image_tag:
                  class: 'block aspect-[633/750] w-full object-cover transition-transform duration-500 group-hover:scale-[1.025]',
                  widths: '360, 540, 720, 960, 1200, 1600',
                  sizes: '(min-width: 1024px) 33vw, 50vw',
                  loading: 'lazy',
                  alt: child_link.title
              }}
            {% else %}
              <div class="flex aspect-[633/750] w-full items-center justify-center bg-gradient-to-br from-stone-100 to-stone-300 p-6 text-center">
                <span class="text-lg font-semibold uppercase tracking-widest text-gray-500 md:text-2xl">
                  {{- child_link.title | escape -}}
                </span>
              </div>
            {% endif %}

            <div class="absolute inset-x-0 bottom-0 z-10 flex flex-col items-center bg-gradient-to-t from-black/60 via-black/10 to-transparent px-2 pb-2 pt-16 text-center md:px-5 md:pb-5 md:pt-24 lg:pb-10">
              <h2 class="m-0 w-full text-base font-bold uppercase text-white drop-shadow-md sm:text-xl md:text-3xl xl:text-4xl">
                {{ child_link.title | escape }}
              </h2>
              <span class="mt-1 inline-flex min-h-8 items-center justify-center bg-[var(--collection-accent)] px-3 py-1.5 text-[9px] font-medium uppercase tracking-wide text-white shadow-md sm:text-[10px] md:mt-4 md:min-h-11 md:px-9 md:py-2 md:text-sm">
                {{- section.settings.button_label | escape -}}
              </span>
            </div>
          </a>
        </article>
      {% endfor %}
    </div>
  {% else %}
    <header class="flex min-h-20 items-center justify-center bg-gray-200 px-5 py-5 uppercase md:min-h-24">
      <h1 class="m-0 text-center text-4xl font-bold tracking-tight text-[var(--collection-accent)] md:text-6xl">
        {{ collection.title | escape }}
      </h1>
    </header>

    {% paginate collection.products by section.settings.products_per_page %}
      <div class="grid grid-cols-1 items-center gap-3 bg-white px-4 py-3 md:grid-cols-2 lg:grid-cols-4">
        <nav class="min-w-0 overflow-hidden text-base md:col-span-1" aria-label="Breadcrumb">
          <ol class="flex list-none items-center gap-2 overflow-x-auto whitespace-nowrap p-0">
            <li>
              <a class="hover:text-[var(--collection-accent)] hover:underline" href="{{ routes.root_url }}">Home</a>
            </li>
            {% if grandparent_title != blank %}
              <li aria-hidden="true">›</li>
              <li>
                <a class="hover:text-[var(--collection-accent)] hover:underline" href="{{ grandparent_url }}">
                  {{- grandparent_title -}}
                </a>
              </li>
            {% endif %}
            {% if parent_title != blank %}
              <li aria-hidden="true">›</li>
              <li>
                <a class="hover:text-[var(--collection-accent)] hover:underline" href="{{ parent_url }}">
                  {{- parent_title -}}
                </a>
              </li>
            {% endif %}
            <li aria-hidden="true">›</li>
            <li class="font-bold text-[var(--collection-accent)]" aria-current="page">{{ collection.title }}</li>
          </ol>
        </nav>

        {% if related_links != blank %}
          <nav class="hidden min-w-0 items-center justify-center lg:col-span-2 lg:flex" aria-label="Related categories">
            <ul class="flex list-none flex-wrap items-center justify-center gap-y-2 p-0 text-base">
              <li>
                <a class="pr-3 font-bold hover:text-[var(--collection-accent)] hover:underline" href="{{ related_url }}"
                  >All {{ related_title -}}
                </a>
              </li>
              {% for sibling_link in related_links %}
                <li class="flex items-center">
                  <span class="pr-3 text-gray-400" aria-hidden="true">|</span
                  ><a
                    class="pr-3 {% if sibling_link.current %}font-bold text-[var(--collection-accent)]{% else %}hover:text-[var(--collection-accent)] hover:underline{% endif %}"
                    href="{{ sibling_link.url }}"
                  >
                    {{- sibling_link.title -}}
                  </a>
                </li>
              {% endfor %}
            </ul>
          </nav>
        {% else %}
          <div class="hidden lg:col-span-2 lg:block"></div>
        {% endif %}

        <form class="flex justify-end md:col-start-2 lg:col-start-4" method="get">
          {%- comment -%}
            Carry the active storefront filters through the sort form, so
            changing the order never silently drops them.
          {%- endcomment -%}
          {%- for filter in collection.filters -%}
            {%- case filter.type -%}
              {%- when 'price_range' -%}
                {%- if filter.min_value.value != null -%}
                  <input
                    type="hidden"
                    name="{{ filter.min_value.param_name }}"
                    value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                  >
                {%- endif -%}
                {%- if filter.max_value.value != null -%}
                  <input
                    type="hidden"
                    name="{{ filter.max_value.param_name }}"
                    value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                  >
                {%- endif -%}
              {%- else -%}
                {%- for value in filter.active_values -%}
                  <input type="hidden" name="{{ value.param_name }}" value="{{ value.value | escape }}">
                {%- endfor -%}
            {%- endcase -%}
          {%- endfor -%}
          <label class="sr-only" for="SortBy-{{ section.id }}">Sort products</label>
          <select
            class="h-11 w-44 cursor-pointer border-0 bg-transparent px-3 text-base uppercase outline-none focus-visible:ring-2 focus-visible:ring-[var(--collection-accent)]"
            id="SortBy-{{ section.id }}"
            name="sort_by"
            data-sort-select
          >
            <option
              value="{{ collection.default_sort_by }}"
              {% if sort_by == collection.default_sort_by %}
                selected
              {% endif %}
            >
              Sort by
            </option>
            <option
              value="created-descending"
              {% if sort_by == 'created-descending' %}
                selected
              {% endif %}
            >
              Latest arrivals
            </option>
            <option
              value="price-descending"
              {% if sort_by == 'price-descending' %}
                selected
              {% endif %}
            >
              Price high to low
            </option>
            <option
              value="price-ascending"
              {% if sort_by == 'price-ascending' %}
                selected
              {% endif %}
            >
              Price low to high
            </option>
          </select>
        </form>

        {% if related_links != blank %}
          <div class="md:col-span-2 lg:hidden">
            <label class="sr-only" for="CategorySelect-{{ section.id }}">Related categories</label>
            <select
              class="h-11 w-full cursor-pointer rounded-none border border-gray-300 bg-white px-3 text-center text-base uppercase outline-none focus:border-[var(--collection-accent)]"
              id="CategorySelect-{{ section.id }}"
              data-category-select
            >
              <option value="{{ related_url }}">All {{ related_title }}</option>
              {% for sibling_link in related_links %}
                <option
                  value="{{ sibling_link.url }}"
                  {% if sibling_link.current %}
                    selected
                  {% endif %}
                >
                  {{ sibling_link.title }}
                </option>
              {% endfor %}
            </select>
          </div>
        {% endif %}
      </div>

      {% if section.settings.show_description and collection.description != blank %}
        <div class="mx-auto max-w-4xl px-5 py-5 text-center leading-7 text-gray-600 [&_p]:m-0">
          {{ collection.description }}
        </div>
      {% endif %}

      {% if section.settings.enable_filtering %}
        {% render 'collection-filters',
          filters: collection.filters,
          form_url: collection.url,
          results: paginate,
          section_id: section.id,
          sort_by: sort_by
        %}
      {% endif %}

      {% if paginate.items > 0 %}
        <div class="grid grid-cols-1 gap-4 bg-white p-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
          {% for product in collection.products -%}
            {%- render 'product_single', product_card_product: product -%}
          {%- endfor %}
        </div>

        <div class="px-5 pb-5 text-center">
          <p class="m-0 inline-block border-b border-gray-800 py-2 text-sm">
            Showing {{ paginate.current_offset | plus: 1 }}–
            {%- if paginate.next -%}
              {{- paginate.current_offset | plus: paginate.page_size -}}
            {%- else -%}
              {{- paginate.items -}}
            {%- endif %}
            of {{ paginate.items }} results
          </p>
        </div>

        {% if paginate.pages > 1 %}
          <nav class="flex items-center justify-center gap-2 px-5 pb-10" aria-label="Collection pagination">
            {% if paginate.previous -%}
              <a
                class="rounded border border-gray-300 px-4 py-2 hover:border-[var(--collection-accent)] hover:text-[var(--collection-accent)]"
                href="{{ paginate.previous.url }}"
                >Previous</a
              >
            {%- endif %}
            <span class="px-3 text-sm text-gray-600">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
            {% if paginate.next -%}
              <a
                class="rounded border border-gray-300 px-4 py-2 hover:border-[var(--collection-accent)] hover:text-[var(--collection-accent)]"
                href="{{ paginate.next.url }}"
                >Next</a
              >
            {%- endif %}
          </nav>
        {% endif %}
      {% elsif active_filter_count > 0 %}
        <div class="px-5 py-16 text-center">
          <div class="mx-auto inline-block border border-gray-300 p-7 text-gray-600">
            <h2 class="m-0 text-xl text-gray-700">No products match these filters</h2>
            <p class="mt-2">Try removing a filter to see more of {{ collection.title | escape }}.</p>
            <a
              class="mt-4 inline-flex min-h-11 items-center justify-center bg-[var(--collection-accent)] px-8 py-2 uppercase text-white"
              href="{{ collection.url }}{% if sort_by != blank %}?sort_by={{ sort_by }}{% endif %}"
              >Clear all filters</a
            >
          </div>
        </div>
      {% else %}
        <div class="px-5 py-16 text-center">
          <div class="mx-auto inline-block border border-gray-300 p-7 text-gray-600">
            <p class="m-0 uppercase">All products are sold!</p>
            <img
              class="mx-auto my-4 w-28 opacity-80"
              src="{{ 'sold-out-grey.png' | asset_url }}"
              alt="Sold out"
              width="128"
              height="128"
              loading="lazy"
            >
            <h2 class="m-0 text-xl text-gray-700">Let's shop in other categories!</h2>
            <a
              class="mt-4 inline-flex min-h-11 items-center justify-center bg-[var(--collection-accent)] px-8 py-2 uppercase text-white"
              href="{{ routes.root_url }}"
              >Start shopping</a
            >
          </div>
        </div>
      {% endif %}
    {% endpaginate %}
  {% endif %}
</section>

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section || section.dataset.collectionReady === 'true') return;
    section.dataset.collectionReady = 'true';
    section.querySelector('[data-sort-select]')?.addEventListener('change', (event) => event.target.form.submit());
    section.querySelector('[data-category-select]')?.addEventListener('change', (event) => {
      window.location.href = event.target.value;
    });
  })();
</script>

{% schema %}
{
  "name": "Collection and categories",
  "settings": [
    {
      "type": "link_list",
      "id": "category_menu",
      "label": "Category navigation menu",
      "default": "main-menu",
      "info": "Top-level collections with nested collection links display as category landing pages."
    },
    { "type": "text", "id": "button_label", "label": "Category button label", "default": "View products" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#7d1717" },
    {
      "type": "checkbox",
      "id": "show_category_heading",
      "label": "Show heading on category landing pages",
      "default": false
    },
    { "type": "checkbox", "id": "show_description", "label": "Show collection description", "default": true },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Show storefront filters",
      "default": true,
      "info": "Filters come from the Shopify Search & Discovery app. Nothing is shown until filters are configured there."
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 32,
      "step": 4,
      "default": 16
    }
  ],
  "presets": [{ "name": "Collection and categories" }]
}
{% endschema %}
