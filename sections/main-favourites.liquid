<section
  class="bg-gray-50 py-10 sm:py-14"
  style="--favorite-accent: {{ section.settings.accent_color }}"
  data-favourites-page
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-9 text-center">
      <p class="text-sm uppercase tracking-[0.24em] text-gray-500">Saved for later</p>
      <h1 class="mt-2 text-3xl font-bold uppercase text-[var(--favorite-accent)] sm:text-5xl">Favourites</h1>
    </div>
    <div class="hidden min-h-72 place-items-center text-center" data-favourites-empty>
      <div>
        <svg class="mx-auto size-20 fill-none stroke-gray-300 stroke-1" viewBox="0 0 24 24">
          <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.9-8.6a5.5 5.5 0 0 0-.1-7.8Z"/>
        </svg>
        <h2 class="mt-4 text-xl font-semibold">No favourites yet</h2>
        <p class="mt-2 text-gray-500">Tap the heart on a product to save it here.</p>
        <a
          class="mt-6 inline-flex bg-[var(--favorite-accent)] px-7 py-3 font-semibold uppercase text-white"
          href="{{ routes.all_products_collection_url }}"
          >Explore products</a
        >
      </div>
    </div>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-7" data-favourites-grid></div>
  </div>
</section>
<script>
  (() => {
    const section = document.currentScript.previousElementSibling;
    if (!section) return;
    const escapeHtml = (value) =>
      String(value ?? '').replace(
        /[&<>'"]/g,
        (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[character],
      );
    const render = () => {
      const items = JSON.parse(localStorage.getItem('deshal-favorites') || '[]'),
        grid = section.querySelector('[data-favourites-grid]'),
        empty = section.querySelector('[data-favourites-empty]');
      empty.classList.toggle('hidden', items.length > 0);
      empty.classList.toggle('grid', items.length === 0);
      grid.innerHTML = items
        .map(
          (item) =>
            `<article class="relative overflow-hidden rounded-md bg-white shadow-sm"><button class="absolute right-2 top-2 z-10 grid size-9 place-items-center rounded-full border-0 bg-white/90 text-red-700 shadow" type="button" aria-label="Remove from favourites" data-favorite-toggle data-product='${escapeHtml(JSON.stringify(item))}'><svg class="size-5 fill-current stroke-current" viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.9-8.6a5.5 5.5 0 0 0-.1-7.8Z"/></svg></button><a href="${escapeHtml(item.url)}"><div class="aspect-[4/5] bg-gray-100"><img class="h-full w-full object-cover" src="${escapeHtml(item.image)}" alt="${escapeHtml(item.title)}" loading="lazy"></div><div class="p-3"><h2 class="truncate font-semibold">${escapeHtml(item.title)}</h2><p class="mt-1">${escapeHtml(item.price)}</p></div></a></article>`,
        )
        .join('');
    };
    render();
    document.addEventListener('favorites:changed', render);
  })();
</script>
{% schema %}
{
  "name": "Favourites page",
  "settings": [{ "type": "color", "id": "accent_color", "label": "Accent color", "default": "#7d1717" }],
  "presets": [{ "name": "Favourites page" }]
}
{% endschema %}
