<section
  class="min-h-[60vh] bg-white text-gray-900"
  style="--search-accent: {{ section.settings.accent_color }}; --collection-accent: {{ section.settings.accent_color }};"
>
  <header class="bg-gray-100 px-5 py-10 text-center sm:py-14">
    <h1 class="m-0 text-3xl font-bold uppercase tracking-tight text-[var(--search-accent)] sm:text-5xl">Search</h1>
    <form
      class="mx-auto mt-7 flex max-w-2xl overflow-hidden border border-gray-300 bg-white focus-within:border-[var(--search-accent)] focus-within:ring-1 focus-within:ring-[var(--search-accent)]"
      action="{{ routes.search_url }}"
      method="get"
      role="search"
    >
      <label class="sr-only" for="SearchPageInput-{{ section.id }}">Search the store</label>
      <svg
        class="ml-4 size-5 shrink-0 self-center fill-none stroke-gray-500 stroke-2"
        aria-hidden="true"
        viewBox="0 0 24 24"
      >
        <circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/>
      </svg>
      <input
        class="min-h-12 min-w-0 flex-1 border-0 bg-transparent px-3 text-base outline-none"
        id="SearchPageInput-{{ section.id }}"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="Search products, articles, and pages"
        autocomplete="off"
        enterkeyhint="search"
        required
      >
      <input type="hidden" name="type" value="product,article,page">
      <input type="hidden" name="options[prefix]" value="last">
      <button
        class="min-h-12 shrink-0 bg-[var(--search-accent)] px-5 font-semibold text-white transition hover:brightness-110 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-white sm:px-8"
        type="submit"
      >
        Search
      </button>
    </form>
  </header>

  <div class="mx-auto max-w-screen-2xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    {% if search.performed %}
      {% if search.results_count > 0 %}
        <div class="mb-8 flex flex-col gap-2 border-b border-gray-200 pb-5 sm:flex-row sm:items-end sm:justify-between">
          <h2 class="m-0 text-2xl font-semibold">
            Results for “<span class="text-[var(--search-accent)]">{{ search.terms | escape }}</span>”
          </h2>
          <p class="m-0 text-sm text-gray-600">
            {{ search.results_count }}
            {% if search.results_count == 1 %}result{% else %}results{% endif %}
          </p>
        </div>

        {% paginate search.results by section.settings.results_per_page %}
          {% assign has_products = false %}
          {% assign has_content = false %}
          {% for item in search.results %}
            {% if item.object_type == 'product' %}
              {% assign has_products = true %}
            {% else %}
              {% assign has_content = true %}
            {% endif %}
          {% endfor %}

          {% if has_products %}
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
              {% for item in search.results %}
                {% if item.object_type == 'product' %}
                  {% render 'product_single', product_card_product: item %}
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}

          {% if has_content %}
            <div class="{% if has_products %}mt-12 border-t border-gray-200 pt-10{% endif %}">
              <h2 class="mb-5 text-2xl font-semibold">Articles and pages</h2>
              <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
                {% for item in search.results %}
                  {% unless item.object_type == 'product' %}
                    <article class="flex h-full flex-col border border-gray-200 bg-white p-5 transition-shadow hover:shadow-md">
                      <p class="m-0 text-xs font-semibold uppercase tracking-wider text-[var(--search-accent)]">
                        {% if item.object_type == 'article' %}Article{% else %}Page{% endif %}
                      </p>
                      <h3 class="mt-2 text-xl font-semibold">
                        <a class="hover:text-[var(--search-accent)] hover:underline" href="{{ item.url }}">
                          {{- item.title | escape -}}
                        </a>
                      </h3>
                      {% liquid
                        if item.object_type == 'article'
                          assign result_text = item.excerpt_or_content
                        else
                          assign result_text = item.content
                        endif
                      %}
                      {% if result_text != blank %}
                        <p class="mt-3 grow text-sm leading-6 text-gray-600">
                          {{ result_text | strip_html | truncatewords: 28 | escape }}
                        </p>
                      {% endif %}
                      <a
                        class="mt-5 inline-flex min-h-11 items-center font-semibold text-[var(--search-accent)] underline decoration-transparent underline-offset-4 hover:decoration-current"
                        href="{{ item.url }}"
                      >
                        Read more <span class="ml-1" aria-hidden="true">→</span>
                      </a>
                    </article>
                  {% endunless %}
                {% endfor %}
              </div>
            </div>
          {% endif %}

          {% if paginate.pages > 1 %}
            <nav class="mt-12 flex flex-wrap items-center justify-center gap-2" aria-label="Search results pagination">
              {% if paginate.previous %}
                <a
                  class="inline-flex min-h-11 items-center border border-gray-300 px-4 hover:border-[var(--search-accent)] hover:text-[var(--search-accent)]"
                  href="{{ paginate.previous.url }}"
                >
                  Previous
                </a>
              {% endif %}

              {% for part in paginate.parts %}
                {% if part.is_link %}
                  <a
                    class="grid size-11 place-items-center border border-gray-300 hover:border-[var(--search-accent)] hover:text-[var(--search-accent)]"
                    href="{{ part.url }}"
                    aria-label="Go to page {{ part.title }}"
                  >
                    {{- part.title -}}
                  </a>
                {% else %}
                  {% if part.title == paginate.current_page %}
                    <span
                      class="grid size-11 place-items-center bg-[var(--search-accent)] text-white"
                      aria-label="Page {{ part.title }}"
                      aria-current="page"
                    >
                      {{- part.title -}}
                    </span>
                  {% else %}
                    <span class="grid size-11 place-items-center text-gray-500" aria-hidden="true">
                      {{- part.title -}}
                    </span>
                  {% endif %}
                {% endif %}
              {% endfor %}

              {% if paginate.next %}
                <a
                  class="inline-flex min-h-11 items-center border border-gray-300 px-4 hover:border-[var(--search-accent)] hover:text-[var(--search-accent)]"
                  href="{{ paginate.next.url }}"
                >
                  Next
                </a>
              {% endif %}
            </nav>
          {% endif %}
        {% endpaginate %}
      {% else %}
        <div class="mx-auto max-w-xl py-10 text-center">
          <svg class="mx-auto size-14 fill-none stroke-gray-400 stroke-1.5" aria-hidden="true" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/>
          </svg>
          <h2 class="mt-5 text-2xl font-semibold">No results found</h2>
          <p class="mt-3 leading-7 text-gray-600">
            We couldn’t find anything for “{{ search.terms | escape }}”. Check the spelling or try a broader search.
          </p>
          <a
            class="mt-6 inline-flex min-h-11 items-center justify-center bg-[var(--search-accent)] px-7 py-2 font-semibold text-white hover:brightness-110"
            href="{{ routes.all_products_collection_url }}"
          >
            Browse all products
          </a>
        </div>
      {% endif %}
    {% else %}
      <div class="mx-auto max-w-xl py-10 text-center">
        <h2 class="text-2xl font-semibold">What are you looking for?</h2>
        <p class="mt-3 leading-7 text-gray-600">Search by product name, category, or any other keyword.</p>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Search results",
  "tag": "section",
  "class": "section-search",
  "settings": [
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#7d1717" },
    {
      "type": "range",
      "id": "results_per_page",
      "label": "Results per page",
      "min": 8,
      "max": 32,
      "step": 4,
      "default": 16
    }
  ]
}
{% endschema %}
