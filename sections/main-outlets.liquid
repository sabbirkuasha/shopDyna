<section
  class="bg-white text-gray-800"
  style="--outlets-accent: {{ section.settings.accent_color }};"
>
  <header class="flex min-h-20 items-center justify-center bg-gray-200 px-5 py-5 uppercase md:min-h-24">
    <h1 class="m-0 text-center text-4xl font-bold tracking-tight text-[var(--outlets-accent)] md:text-6xl">
      {{ section.settings.heading | escape }}
    </h1>
  </header>

  <div class="mx-auto w-full bg-white px-5 py-8 shadow-lg xl:px-10 xl:py-10 2xl:px-20">
    <div class="overflow-hidden bg-white">
      {% if section.settings.hero_image != blank %}
        {{
          section.settings.hero_image
          | image_url: width: 2400
          | image_tag:
            class: 'block aspect-[1917/858] h-auto w-full object-cover',
            widths: '640, 960, 1280, 1600, 2000, 2400',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: section.settings.hero_image.alt
        }}
      {% else %}
        <img
          class="block aspect-[1917/858] h-auto w-full object-cover"
          src="{{ 'deshal_banani.jpg' | asset_url }}"
          alt="Deshal Banani outlet"
          width="1917"
          height="858"
          loading="eager"
          fetchpriority="high"
        >
      {% endif %}

      {% if section.settings.introduction != blank %}
        <div class="bg-gray-200 px-5 py-5 text-center text-sm leading-7 text-gray-600 sm:text-base">
          <div class="mx-auto max-w-2xl [&_p]:m-0 [&_p+p]:mt-1">{{ section.settings.introduction }}</div>
        </div>
      {% endif %}
    </div>

    <div class="grid grid-cols-1 gap-5 py-6 xl:grid-cols-2 xl:p-10">
      {% for block in section.blocks %}
        <article
          class="overflow-hidden rounded-md border border-gray-200 bg-white shadow-sm transition-shadow hover:shadow-md xl:flex"
          {{ block.shopify_attributes }}
        >
          <div class="h-72 bg-gray-100 sm:h-96 xl:h-auto xl:min-h-96 xl:w-1/2">
            {% if block.settings.map_embed_url != blank %}
              <iframe
                class="h-full w-full border-0"
                title="Map showing {{ block.settings.name | escape }}"
                src="{{ block.settings.map_embed_url }}"
                allowfullscreen
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            {% else %}
              <div class="flex h-full flex-col items-center justify-center gap-3 px-6 text-center text-gray-500">
                <svg
                  class="size-10 fill-none stroke-[var(--outlets-accent)] stroke-1.5"
                  aria-hidden="true"
                  viewBox="0 0 24 24"
                >
                  <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/>
                </svg>
                <p class="m-0 text-sm">Add the Google Maps embed URL in this outlet block.</p>
              </div>
            {% endif %}
          </div>

          <div class="flex w-full flex-col items-center justify-center px-6 py-8 text-center xl:w-1/2 xl:py-12">
            <h2 class="m-0 text-xl font-medium text-gray-900">{{ block.settings.name | escape }}</h2>
            {% if block.settings.address != blank %}
              <div class="mt-4 max-w-sm whitespace-pre-line text-sm leading-6 text-gray-600 sm:text-base">
                {{ block.settings.address | escape }}
              </div>
            {% endif %}
            {% if block.settings.phone != blank %}
              <a
                class="mt-3 font-medium text-[var(--outlets-accent)] hover:underline"
                href="tel:{{ block.settings.phone | remove: ' ' }}"
              >
                {{ block.settings.phone | escape }}
              </a>
            {% endif %}
            {% if block.settings.directions_url != blank %}
              <a
                class="mt-6 inline-flex min-h-11 w-full items-center justify-center rounded border border-[var(--outlets-accent)] px-5 py-2 font-medium text-[var(--outlets-accent)] transition hover:bg-[var(--outlets-accent)] hover:text-white"
                href="{{ block.settings.directions_url }}"
                target="_blank"
                rel="noopener noreferrer"
              >
                Get directions
              </a>
            {% endif %}
          </div>
        </article>
      {% else %}
        <div class="col-span-full rounded-md border border-dashed border-gray-300 px-6 py-16 text-center text-gray-500">
          Add an outlet block from the Theme Editor to display a location.
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Outlets page",
  "tag": "section",
  "class": "section-outlets",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Outlets" },
    { "type": "image_picker", "id": "hero_image", "label": "Storefront image" },
    {
      "type": "richtext",
      "id": "introduction",
      "label": "Introduction",
      "default": "<p>Walk into our store to get up close and personal with the world of handcrafted goodness.</p><p>From appealing apparel to homey homeware; explore the world of DESHAL.</p>"
    },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#b91c1c" }
  ],
  "blocks": [
    {
      "type": "outlet",
      "name": "Outlet",
      "settings": [
        { "type": "text", "id": "name", "label": "Outlet name", "default": "Bashundhara Outlet" },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address",
          "default": "Level 7, Block A, Bashundhara City Shopping Complex, Panthapath, Dhaka"
        },
        { "type": "text", "id": "phone", "label": "Phone", "default": "01318 240411" },
        { "type": "url", "id": "map_embed_url", "label": "Google Maps embed URL" },
        { "type": "url", "id": "directions_url", "label": "Google Maps directions URL" }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [{ "name": "Outlets page", "blocks": [{ "type": "outlet" }] }]
}
{% endschema %}
