<section class="bg-gray-50 py-10 sm:py-14" style="--account-accent: {{ section.settings.accent_color }}">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-sm uppercase tracking-[0.2em] text-gray-500">My account</p>
        <h1 class="mt-1 text-3xl font-bold text-[var(--account-accent)]">
          Hello, {{ customer.first_name | default: customer.name }}
        </h1>
      </div>
      <a
        class="border border-gray-400 px-5 py-2 text-sm font-semibold uppercase hover:border-[var(--account-accent)]"
        href="{{ routes.account_logout_url }}"
        >Sign out</a
      >
    </div>
    <div class="mt-8 grid gap-7 lg:grid-cols-[1fr_300px]">
      <div class="overflow-hidden rounded-md bg-white shadow-sm">
        <h2 class="border-b px-5 py-4 text-xl font-bold uppercase">Order history</h2>
        {% if customer.orders.size == 0 %}
          <div class="p-10 text-center text-gray-500">You haven't placed any orders yet.</div>
        {% else %}
          <div class="overflow-x-auto">
            <table class="w-full min-w-[680px] text-left">
              <thead class="bg-gray-100 text-sm uppercase">
                <tr>
                  <th class="p-4">Order</th>
                  <th class="p-4">Date</th>
                  <th class="p-4">Payment</th>
                  <th class="p-4">Fulfillment</th>
                  <th class="p-4 text-right">Total</th>
                </tr>
              </thead>
              <tbody>
                {% for order in customer.orders %}
                  <tr class="border-t">
                    <td class="p-4">
                      <a class="font-semibold text-[var(--account-accent)] underline" href="{{ order.customer_url }}">
                        {{- order.name -}}
                      </a>
                    </td>
                    <td class="p-4">{{ order.created_at | date: '%b %d, %Y' }}</td>
                    <td class="p-4">{{ order.financial_status_label }}</td>
                    <td class="p-4">{{ order.fulfillment_status_label }}</td>
                    <td class="p-4 text-right font-semibold">{{ order.total_net_amount | money }}</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% endif %}
      </div>
      <aside class="h-fit rounded-md bg-white p-5 shadow-sm">
        <h2 class="text-xl font-bold uppercase">Account details</h2>
        <div class="mt-4 text-sm leading-7">{{ customer.default_address | format_address }}</div>
        <a
          class="mt-5 inline-flex w-full justify-center border border-[var(--account-accent)] px-4 py-3 font-semibold uppercase text-[var(--account-accent)]"
          href="{{ routes.account_addresses_url }}"
          >Manage addresses ({{ customer.addresses_count }})</a
        >
      </aside>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Customer account",
  "settings": [{ "type": "color", "id": "accent_color", "label": "Accent color", "default": "#7d1717" }]
}
{% endschema %}
