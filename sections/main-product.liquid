{% liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign product_form_id = 'ProductForm-' | append: section.id
  assign designer = product.metafields.custom.designer.value
  assign fabric = product.metafields.custom.fabric.value
  assign product_color = product.metafields.custom.color.value
%}
<section
  id="MainProduct-{{ section.id }}"
  class="bg-white py-3 text-gray-900 lg:px-2 xl:px-10 2xl:px-20"
  style="--product-accent:{{ section.settings.accent_color }}"
  data-main-product
>
  <nav class="px-5 pb-3 text-sm text-gray-600 lg:px-0" aria-label="Breadcrumb">
    <ol class="flex list-none flex-wrap items-center gap-2 p-0">
      <li><a class="hover:text-[var(--product-accent)] hover:underline" href="{{ routes.root_url }}">Home</a></li>
      {% if product.collections.first != blank %}
        <li>›</li>
        <li>
          <a class="hover:text-[var(--product-accent)] hover:underline" href="{{ product.collections.first.url }}">
            {{- product.collections.first.title -}}
          </a>
        </li>
      {% endif %}
      <li>›</li>
      <li class="font-semibold text-[var(--product-accent)]" aria-current="page">{{ product.title }}</li>
    </ol>
  </nav>

  <div class="grid grid-cols-1 lg:grid-cols-2 lg:gap-5">
    <div class="min-w-0 px-5 lg:px-0" data-product-gallery>
      {% if product.media.size > 0 %}
        <div class="flex flex-col gap-3 lg:flex-row">
          {% if product.media.size > 1 %}
            <div class="order-2 flex gap-2 overflow-x-auto lg:order-1 lg:max-h-[700px] lg:w-20 lg:shrink-0 lg:flex-col lg:overflow-y-auto">
              {% for media in product.media -%}
                <button
                  class="shrink-0 cursor-pointer overflow-hidden border-2 {% if forloop.first %}border-[var(--product-accent)]{% else %}border-transparent{% endif %} bg-gray-100 p-0"
                  type="button"
                  aria-label="View media {{ forloop.index }}"
                  aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                  data-media-thumb="{{ media.id }}"
                >
                  {{
                    media.preview_image
                    | image_url: width: 180
                    | image_tag: class: 'aspect-[4/5] h-24 w-20 object-cover', loading: 'lazy', alt: media.alt
                  }}
                </button>
              {%- endfor %}
            </div>
          {% endif %}
          <div class="order-1 min-w-0 flex-1 bg-gray-50 lg:order-2">
            {% for media in product.media %}
              <div class="{% unless forloop.first %}hidden{% endunless %}" data-media-panel="{{ media.id }}">
                {% case media.media_type -%}
                  {%- when 'image' -%}
                    <button
                      class="block w-full cursor-zoom-in border-0 bg-transparent p-0"
                      type="button"
                      data-zoom-open="ProductZoom-{{ section.id }}-{{ media.id }}"
                    >
                      {{
                        media
                        | image_url: width: 1800
                        | image_tag:
                          class: 'block h-auto max-h-[780px] w-full object-contain',
                          widths: '600,900,1200,1500,1800',
                          sizes: '(min-width:1024px) 50vw,100vw',
                          loading: 'eager',
                          alt: media.alt
                      }}
                    </button>
                    <dialog
                      id="ProductZoom-{{ section.id }}-{{ media.id }}"
                      class="m-auto max-h-[94vh] max-w-[94vw] bg-transparent p-0 backdrop:bg-black/80"
                    >
                      <div class="relative">
                        <button
                          class="absolute right-3 top-3 z-10 grid size-11 cursor-pointer place-items-center rounded-full bg-white text-2xl shadow-lg"
                          type="button"
                          aria-label="Close enlarged image"
                          data-zoom-close
                        >
                          ×
                        </button>
                        {{-
                          media
                          | image_url: width: 2400
                          | image_tag:
                            class: 'max-h-[94vh] max-w-[94vw] object-contain',
                            loading: 'lazy',
                            alt: media.alt
                        }}
                      </div>
                    </dialog>
                  {% when 'external_video' %}
                    <div class="aspect-video">{{ media | external_video_tag: class: 'h-full w-full' }}</div>
                  {% when 'video' -%}
                    {{- media | media_tag: controls: true, class: 'h-auto w-full' -}}
                  {%- when 'model' -%}
                    {{-
                      media
                      | model_viewer_tag: reveal: 'interaction', toggleable: true, class: 'aspect-square w-full'
                    -}}
                {%- endcase %}
              </div>
            {% endfor %}
          </div>
        </div>
      {% else -%}
        {{- 'product-1' | placeholder_svg_tag: 'aspect-[4/5] w-full bg-gray-100 text-gray-300' -}}
      {%- endif %}
    </div>

    <div class="mt-5 h-fit rounded-md px-5 py-5 shadow-xl lg:mt-0 xl:p-7 2xl:p-10">
      {% form 'product', product, id: product_form_id, class: 'flex flex-col gap-3', data-product-form: '' %}
        <div>
          <h1 class="m-0 text-2xl font-bold">{{ product.title | escape }}</h1>
          <div
            class="mt-2 flex flex-wrap items-baseline gap-2 font-bold text-[var(--product-accent)]"
            data-product-price
          >
            <span class="text-2xl">{{ selected_variant.price | money }}</span
            ><span
              class="text-lg text-gray-400 line-through{% unless selected_variant.compare_at_price > selected_variant.price %} hidden{% endunless %}"
              data-compare-price
            >
              {{- selected_variant.compare_at_price | money -}}
            </span>
            {%- if product.price_varies -%}
              <span class="text-xs font-normal uppercase">Price varies by option</span>
            {%- endif %}
          </div>
        </div>
        <div class="flex items-center gap-2 text-base sm:text-xl">
          <span>SKU:</span><span data-product-sku>{{ selected_variant.sku | default: 'N/A' }}</span
          ><button
            class="grid size-8 cursor-pointer place-items-center border-0 bg-transparent transition hover:scale-110 hover:text-[var(--product-accent)]"
            type="button"
            aria-label="Copy SKU"
            data-copy-sku
          >
            <svg class="size-5 fill-none stroke-current stroke-1.5" viewBox="0 0 24 24">
              <path d="M15.75 17.25v3.38c0 .62-.5 1.12-1.13 1.12H4.88c-.63 0-1.13-.5-1.13-1.12V7.88c0-.63.5-1.13 1.13-1.13h1.87M9.38 17.25h9.75c.62 0 1.12-.5 1.12-1.13v-4.87a9 9 0 0 0-9-9H9.37c-.62 0-1.12.5-1.12 1.13v12.74c0 .63.5 1.13 1.12 1.13Z"/>
            </svg>
          </button>
        </div>
        {% if product_color != blank %}
          <p class="m-0 text-base sm:text-xl">Color: {{ product_color }}</p>
        {% endif %}

        <select class="hidden" name="id" data-variant-select>
          {% for variant in product.variants %}
            <option
              value="{{ variant.id }}"
              data-options="{{ variant.options | json | escape }}"
              data-price="{{ variant.price | money | escape }}"
              data-compare-price="{{ variant.compare_at_price | money | escape }}"
              data-has-compare="{% if variant.compare_at_price > variant.price %}true{% else %}false{% endif %}"
              data-sku="{{ variant.sku | escape }}"
              data-available="{{ variant.available }}"
              data-media-id="{{ variant.featured_media.id }}"
              {% if variant.id == selected_variant.id %}
                selected
              {% endif %}
            >
              {{ variant.title }}
            </option>
          {% endfor %}
        </select>
        {% unless product.has_only_default_variant %}
          <div class="mt-2 grid gap-4">
            {% for option in product.options_with_values %}
              <fieldset class="m-0 border-0 p-0" data-product-option>
                <legend class="mb-2 text-lg">Select {{ option.name }}</legend>
                <div class="flex flex-wrap gap-2 sm:gap-3">
                  {% for value in option.values -%}
                    <label class="cursor-pointer"
                      ><input
                        class="peer sr-only"
                        type="radio"
                        name="option-{{ option.position }}"
                        value="{{ value | escape }}"
                        {% if option.selected_value == value %}
                          checked
                        {% endif %}

                      ><span class="inline-flex min-h-11 min-w-14 items-center justify-center border border-gray-300 bg-white px-4 py-2 text-sm uppercase transition peer-checked:border-[var(--product-accent)] peer-checked:bg-[var(--product-accent)] peer-checked:text-white hover:border-[var(--product-accent)]">
                        {{- value -}}
                      </span></label
                    >
                  {%- endfor %}
                </div>
              </fieldset>
            {% endfor %}
          </div>
        {% endunless %}
        <div
          class="mt-2 rounded-md bg-amber-500 px-4 py-2 text-center font-medium uppercase tracking-wide text-white{% if selected_variant.available %} hidden{% endif %}"
          data-stock-message
        >
          Stock out
        </div>

        <div class="mt-2 flex flex-wrap items-stretch gap-2 text-center uppercase xl:gap-4">
          <div class="flex h-12 shrink-0">
            <button
              class="w-11 cursor-pointer border-0 bg-gray-300 text-2xl"
              type="button"
              aria-label="Decrease quantity"
              data-quantity-minus
            >
              −</button
            ><label class="sr-only" for="ProductQuantity-{{ section.id }}">Quantity</label
            ><input
              class="w-14 border-0 bg-gray-100 text-center text-lg font-bold outline-none"
              id="ProductQuantity-{{ section.id }}"
              name="quantity"
              type="number"
              min="1"
              value="1"
              data-quantity-input

            ><button
              class="w-11 cursor-pointer border-0 bg-gray-300 text-2xl"
              type="button"
              aria-label="Increase quantity"
              data-quantity-plus
            >
              +
            </button>
          </div>
          <button
            class="h-12 min-w-40 flex-1 cursor-pointer border-0 bg-[var(--product-accent)] px-5 font-semibold text-white hover:brightness-110 disabled:bg-gray-400"
            type="submit"
            name="add"
            {% unless selected_variant.available %}
              disabled
            {% endunless %}
            data-add-button
          >
            <span data-add-label>
              {%- if selected_variant.available %}Add to cart{% else %}Sold out{% endif -%}
            </span></button
          ><button
            class="h-12 min-w-32 flex-1 cursor-pointer border-0 bg-amber-500 px-5 font-semibold text-white hover:bg-amber-600 disabled:bg-gray-400"
            type="submit"
            name="return_to"
            value="/checkout"
            {% unless selected_variant.available %}
              disabled
            {% endunless %}
            data-buy-button
          >
            Buy now
          </button>
        </div>

        <div class="mt-1 flex flex-wrap gap-2 uppercase">
          {% if section.settings.wishlist_url != blank -%}
            <a
              class="inline-flex h-11 items-center justify-center border border-gray-400 px-4 hover:border-[var(--product-accent)]"
              href="{{ section.settings.wishlist_url }}"
            >
              <svg class="mr-2 size-5 fill-none stroke-current stroke-1.5" viewBox="0 0 24 24">
                <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.9-8.6a5.5 5.5 0 0 0-.1-7.8Z"/>
              </svg>
              Wishlist</a
            >
          {%- endif -%}
          {%- if selected_variant.store_availabilities.size > 0 %}
            <details class="min-w-52 flex-1 border border-gray-400">
              <summary class="flex h-11 cursor-pointer list-none items-center justify-center px-4 text-center">
                Check in-store availability
              </summary>
              <div class="border-t border-gray-300 p-4 normal-case">
                {% for availability in selected_variant.store_availabilities %}
                  <div class="border-b border-gray-200 py-3 last:border-0">
                    <p class="m-0 font-semibold">{{ availability.location.name }}</p>
                    <p class="m-0 text-sm {% if availability.available %}text-green-700{% else %}text-red-700{% endif %}">
                      {% if availability.available -%}
                        Available — {{ availability.pick_up_time -}}
                      {%- else -%}
                        Unavailable
                      {%- endif %}
                    </p>
                  </div>
                {% endfor %}
              </div>
            </details>
          {% endif %}
        </div>
        <p class="my-3 text-center text-xs">{{ section.settings.color_notice | escape }}</p>

        <div class="border-t border-gray-200 pt-5 text-sm leading-6">
          <h2 class="m-0 mb-3 text-xl font-bold text-[var(--product-accent)] md:text-2xl">Product details</h2>
          <dl class="m-0 grid grid-cols-[auto_1fr] gap-x-2 gap-y-1">
            <dt>Product name:</dt>
            <dd class="m-0">{{ product.title }}</dd>
            {% if designer != blank %}
              <dt>Designer:</dt>
              <dd class="m-0">{{ designer }}</dd>
            {% endif -%}
            {%- if fabric != blank %}
              <dt>Fabric:</dt>
              <dd class="m-0">{{ fabric }}</dd>
            {% endif -%}
            {%- if product.type != blank %}
              <dt>Product type:</dt>
              <dd class="m-0">{{ product.type }}</dd>
            {% endif %}
          </dl>
          {% if product.description != blank %}
            <div class="mt-3 text-gray-700 [&_a]:text-[var(--product-accent)] [&_a]:underline [&_ol]:pl-5 [&_p]:my-2 [&_ul]:pl-5">
              {{ product.description }}
            </div>
          {% endif %}
        </div>
        <div class="mt-5 border-t border-gray-200 pt-5 text-center uppercase">
          <p class="m-0">Share with friends</p>
          <div class="mt-3 flex justify-center gap-3">
            <a
              class="grid size-10 place-items-center rounded-full border border-gray-300 hover:text-[var(--product-accent)]"
              href="https://www.facebook.com/sharer/sharer.php?u={{ canonical_url | url_encode }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Share on Facebook"
              >f</a
            ><button
              class="grid size-10 cursor-pointer place-items-center rounded-full border border-gray-300 bg-white hover:text-[var(--product-accent)]"
              type="button"
              aria-label="Copy product link"
              data-copy-link
            >
              ↗
            </button>
          </div>
          <p class="mt-2 hidden text-xs normal-case text-green-700" role="status" data-copy-status>
            Copied to clipboard
          </p>
        </div>
      {% endform %}
    </div>
  </div>
</section>

<script>
  (() => {
    const s = document.getElementById('MainProduct-{{ section.id }}');
    if (!s || s.dataset.initialized) return;
    s.dataset.initialized = 'true';
    const vs = s.querySelector('[data-variant-select]'),
      groups = [...s.querySelectorAll('[data-product-option]')],
      price = s.querySelector('[data-product-price]>span:first-child'),
      compare = s.querySelector('[data-compare-price]'),
      sku = s.querySelector('[data-product-sku]'),
      stock = s.querySelector('[data-stock-message]'),
      add = s.querySelector('[data-add-button]'),
      buy = s.querySelector('[data-buy-button]'),
      label = s.querySelector('[data-add-label]'),
      qty = s.querySelector('[data-quantity-input]');
    const media = (id) => {
      if (!id) return;
      s.querySelectorAll('[data-media-panel]').forEach((x) =>
        x.classList.toggle('hidden', x.dataset.mediaPanel !== id),
      );
      s.querySelectorAll('[data-media-thumb]').forEach((x) => {
        const active = x.dataset.mediaThumb === id;
        x.classList.toggle('border-[var(--product-accent)]', active);
        x.classList.toggle('border-transparent', !active);
        x.setAttribute('aria-pressed', String(active));
      });
    };
    const update = () => {
      const values = groups.map((g) => g.querySelector('input:checked')?.value),
        o = [...vs.options].find((x) => JSON.stringify(values) === JSON.stringify(JSON.parse(x.dataset.options)));
      if (!o) return;
      vs.value = o.value;
      price.textContent = o.dataset.price;
      compare.textContent = o.dataset.comparePrice;
      compare.classList.toggle('hidden', o.dataset.hasCompare !== 'true');
      sku.textContent = o.dataset.sku || 'N/A';
      const available = o.dataset.available === 'true';
      stock.classList.toggle('hidden', available);
      add.disabled = !available;
      buy.disabled = !available;
      label.textContent = available ? 'Add to cart' : 'Sold out';
      media(o.dataset.mediaId);
      history.replaceState({}, '', `${location.pathname}?variant=${o.value}`);
    };
    groups.forEach((g) => g.addEventListener('change', update));
    s.querySelectorAll('[data-media-thumb]').forEach((x) =>
      x.addEventListener('click', () => media(x.dataset.mediaThumb)),
    );
    s.querySelectorAll('[data-zoom-open]').forEach((x) =>
      x.addEventListener('click', () => document.getElementById(x.dataset.zoomOpen)?.showModal()),
    );
    s.querySelectorAll('[data-zoom-close]').forEach((x) =>
      x.addEventListener('click', () => x.closest('dialog')?.close()),
    );
    s.querySelectorAll('dialog').forEach((x) =>
      x.addEventListener('click', (e) => {
        if (e.target === x) x.close();
      }),
    );
    s.querySelector('[data-quantity-minus]')?.addEventListener(
      'click',
      () => (qty.value = Math.max(1, Number(qty.value || 1) - 1)),
    );
    s.querySelector('[data-quantity-plus]')?.addEventListener('click', () => (qty.value = Number(qty.value || 1) + 1));
    s.querySelector('[data-copy-sku]')?.addEventListener('click', () =>
      navigator.clipboard?.writeText(sku.textContent.trim()),
    );
    s.querySelector('[data-copy-link]')?.addEventListener('click', async () => {
      await navigator.clipboard?.writeText(location.href);
      const x = s.querySelector('[data-copy-status]');
      x.classList.remove('hidden');
      setTimeout(() => x.classList.add('hidden'), 2000);
    });
  })();
</script>

{% schema %}
{
  "name": "Main product",
  "settings": [
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#7d1717" },
    {
      "type": "text",
      "id": "color_notice",
      "label": "Color notice",
      "default": "*Product color may slightly vary depending on your device's screen resolution"
    },
    { "type": "url", "id": "wishlist_url", "label": "Wishlist page" }
  ]
}
{% endschema %}
