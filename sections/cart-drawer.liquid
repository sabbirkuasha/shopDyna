<div id="CartDrawerSection" style="--cart-drawer-accent: {{ section.settings.accent_color }}">
  <div class="invisible fixed inset-0 z-[80] bg-black/50 opacity-0 transition" data-cart-drawer-overlay></div>
  <aside
    class="invisible fixed inset-y-0 right-0 z-[90] flex w-[min(440px,92vw)] translate-x-full flex-col bg-white text-gray-900 shadow-2xl transition"
    aria-hidden="true"
    aria-label="Shopping cart"
    data-cart-drawer
  >
    <div class="flex min-h-20 items-center justify-between border-b px-5">
      <div>
        <h2 class="text-xl font-bold uppercase">Your cart</h2>
        <p class="text-sm text-gray-500">
          {{ cart.item_count }}
          {% if cart.item_count == 1 %}item{% else %}items{% endif %}
        </p>
      </div>
      <button
        class="grid size-10 cursor-pointer place-items-center rounded-full border-0 bg-white hover:bg-gray-100"
        type="button"
        aria-label="Close cart"
        data-cart-drawer-close
      >
        <svg class="size-6 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
          <path d="m5 5 14 14M19 5 5 19"/>
        </svg>
      </button>
    </div>
    {% if cart.item_count == 0 %}
      <div class="grid flex-1 place-items-center p-8 text-center">
        <div>
          <svg class="mx-auto size-20 fill-none stroke-gray-300 stroke-1" viewBox="0 0 24 24">
            <path d="M3 3h2l2.2 10.2a2 2 0 0 0 2 1.6h7.9a2 2 0 0 0 2-1.6L21 6H6"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/>
          </svg>
          <h3 class="mt-4 text-xl font-semibold">Your cart is empty</h3>
          <button
            class="mt-6 bg-[var(--cart-drawer-accent)] px-7 py-3 font-semibold uppercase text-white"
            type="button"
            data-cart-drawer-close
          >
            Continue shopping
          </button>
        </div>
      </div>
    {% else %}
      {%- liquid
        assign vat_rate = section.settings.vat_rate | default: 10
        assign vat_divisor = vat_rate | plus: 100.0
        assign included_vat = cart.total_price | times: vat_rate | divided_by: vat_divisor | round
      -%}
      <div class="flex-1 overflow-y-auto p-5">
        <div class="space-y-5">
          {% for item in cart.items %}
            {%- assign item_included_vat = item.final_line_price
              | times: vat_rate
              | divided_by: vat_divisor
              | round
            -%}
            <article class="grid grid-cols-[88px_1fr] gap-4 border-b border-gray-200 pb-5" data-cart-line>
              <a class="h-28 overflow-hidden bg-gray-100" href="{{ item.url }}">
                {%- if item.image -%}
                  {{-
                    item.image
                    | image_url: width: 220
                    | image_tag: class: 'h-full w-full object-cover', loading: 'lazy', alt: item.product.title
                  -}}
                {%- endif -%}
              </a>
              <div class="min-w-0">
                <div class="flex justify-between gap-3">
                  <a class="font-semibold hover:text-[var(--cart-drawer-accent)]" href="{{ item.url }}">
                    {{- item.product.title -}}</a
                  ><button
                    class="h-fit cursor-pointer border-0 bg-transparent text-sm underline"
                    type="button"
                    data-cart-change
                    data-cart-remove
                    data-line="{{ forloop.index }}"
                    data-quantity="0"
                  >
                    Remove
                  </button>
                </div>
                {% unless item.product.has_only_default_variant %}
                  <p class="mt-1 text-sm text-gray-500">{{ item.variant.title }}</p>
                {% endunless %}
                <p class="mt-1 font-medium">{{ item.final_price | money }}</p>
                <p class="mt-1 text-xs text-gray-500">
                  Included VAT ({{ vat_rate }}%): {{ item_included_vat | money }}
                  {%- if item.quantity > 1 %} for {{ item.quantity }} items{% endif -%}
                </p>
                <div
                  class="mt-3 flex h-10 w-32 items-center border border-gray-300 transition-colors focus-within:border-[var(--cart-drawer-accent)]"
                  data-cart-quantity-control
                >
                  <button
                    class="size-9 cursor-pointer border-y-0 border-l-0 border-r border-gray-300 bg-gray-100 text-xl transition-colors hover:bg-gray-200 active:bg-[var(--cart-drawer-accent)] active:text-white disabled:cursor-not-allowed disabled:bg-gray-50 disabled:text-gray-300"
                    type="button"
                    data-cart-change
                    data-line="{{ forloop.index }}"
                    data-quantity="{{ item.quantity | minus: 1 }}"
                    aria-label="Decrease {{ item.product.title }} quantity"
                    {% if item.quantity <= 1 %}disabled{% endif %}
                  >
                    −</button
                  ><span class="relative flex-1 text-center" aria-live="polite">
                    <span data-cart-quantity-value>{{ item.quantity }}</span>
                    <span class="absolute inset-0 hidden items-center justify-center" data-cart-quantity-loading>
                      <svg class="size-4 animate-spin" viewBox="0 0 24 24" aria-hidden="true">
                        <circle class="fill-none stroke-gray-300 stroke-2" cx="12" cy="12" r="9"></circle>
                        <path class="fill-none stroke-[var(--cart-drawer-accent)] stroke-2" d="M12 3a9 9 0 0 1 9 9"></path>
                      </svg>
                      <span class="sr-only">Updating quantity</span>
                    </span>
                  </span
                  ><button
                    class="size-9 cursor-pointer border-y-0 border-r-0 border-l border-gray-300 bg-gray-100 text-xl transition-colors hover:bg-gray-200 active:bg-[var(--cart-drawer-accent)] active:text-white disabled:cursor-wait disabled:bg-gray-50 disabled:text-gray-300"
                    type="button"
                    data-cart-change
                    data-line="{{ forloop.index }}"
                    data-quantity="{{ item.quantity | plus: 1 }}"
                    aria-label="Increase {{ item.product.title }} quantity"
                  >
                    +
                  </button>
                </div>
                <p class="mt-2 hidden text-xs text-red-700" role="alert" data-cart-quantity-error>
                  Couldn't update quantity. Please try again.
                </p>
              </div>
            </article>
          {% endfor %}
        </div>
      </div>
      <div class="border-t bg-gray-50 p-5" data-cart-summary>
        <div data-cart-summary-values>
          <div class="mb-2 flex justify-between text-lg">
            <strong>Subtotal</strong><strong>{{ cart.total_price | money }}</strong>
          </div>
          <div class="mb-2 flex justify-between text-sm text-gray-600">
            <span>Included VAT ({{ vat_rate }}%)</span><span>{{ included_vat | money }}</span>
          </div>
          <div class="mb-3 flex justify-between border-t border-gray-200 pt-3 text-lg">
            <strong>Total (VAT included)</strong><strong class="text-[var(--cart-drawer-accent)]">{{ cart.total_price | money }}</strong>
          </div>
        </div>
        <div class="mb-3 hidden items-center justify-end gap-2 text-sm text-gray-600" role="status" data-cart-summary-loading>
          <svg class="size-4 animate-spin" viewBox="0 0 24 24" aria-hidden="true">
            <circle class="fill-none stroke-gray-300 stroke-2" cx="12" cy="12" r="9"></circle>
            <path class="fill-none stroke-[var(--cart-drawer-accent)] stroke-2" d="M12 3a9 9 0 0 1 9 9"></path>
          </svg>
          <span>Updating totals…</span>
        </div>
        <p class="mb-4 text-sm text-gray-500">Shipping and discounts are calculated at checkout.</p>
        <a
          class="flex h-12 items-center justify-center bg-[var(--cart-drawer-accent)] font-semibold uppercase text-white"
          href="{{ routes.cart_url }}"
          >View cart</a
        >
        <form action="{{ routes.cart_url }}" method="post">
          <button
            class="mt-3 h-12 w-full cursor-pointer border border-[var(--cart-drawer-accent)] bg-white font-semibold uppercase text-[var(--cart-drawer-accent)]"
            name="checkout"
            type="submit"
          >
            Checkout
          </button>
        </form>
      </div>
    {% endif %}
  </aside>
</div>
{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#7d1717"
    },
    {
      "type": "range",
      "id": "vat_rate",
      "label": "Included VAT rate",
      "min": 0,
      "max": 30,
      "step": 0.5,
      "unit": "%",
      "default": 10
    }
  ]
}
{% endschema %}
