{% liquid
  assign privacy_url = shop.privacy_policy.url | default: '/policies/privacy-policy'
  assign terms_url = shop.terms_of_service.url | default: '/policies/terms-of-service'
  assign shipping_url = shop.shipping_policy.url | default: '/policies/shipping-policy'
  assign refund_url = shop.refund_policy.url | default: '/policies/refund-policy'
  assign brand_profile_url = section.settings.brand_profile_url | default: '/pages/brand-profile'
  assign about_us_url = section.settings.about_us_url | default: '/pages/about-us'
  assign outlets_url = section.settings.outlets_url | default: '/pages/outlets'
  assign contact_url = section.settings.contact_url | default: '/pages/contact-us'
%}

<footer
  class="bg-gray-100 bg-cover bg-center text-gray-700 shadow-[0_-5px_18px_rgb(0_0_0/0.08)]"
  style="--footer-accent: {{ section.settings.accent_color }};{% if section.settings.background_image != blank %} background-image: url('{{ section.settings.background_image | image_url: width: 2400 }}');{% else %} background-image: url('{{ 'footer.png' | asset_url }}');{% endif %}"
>
  <div class="h-1 w-full bg-red-100"></div>

  <div class="mx-auto max-w-7xl px-6 pb-9 pt-8 sm:px-10 lg:px-16">
    {% if section.settings.tagline != blank %}
      <div class="mx-auto max-w-5xl text-center text-base font-bold uppercase leading-7 text-[var(--footer-accent)] drop-shadow-sm md:text-2xl md:leading-9">
        {{ section.settings.tagline | escape }}
      </div>
      <div class="mx-auto mt-6 h-0.5 w-2/3 max-w-3xl rounded-full bg-white shadow-sm"></div>
    {% endif %}

    <div class="mx-auto grid max-w-4xl grid-cols-1 gap-8 py-9 text-center sm:grid-cols-3 sm:text-left">
      <nav class="flex flex-col items-center gap-2 sm:items-start" aria-labelledby="FooterAbout-{{ section.id }}">
        <h2
          id="FooterAbout-{{ section.id }}"
          class="mb-1 text-lg font-bold capitalize text-gray-600 underline underline-offset-4"
        >
          {{ section.settings.about_heading | escape }}
        </h2>
        {% if section.settings.about_menu != blank %}
          {% for link in section.settings.about_menu.links -%}
            <a class="capitalize hover:text-[var(--footer-accent)] hover:underline" href="{{ link.url }}">
              {{- link.title -}}
            </a>
          {%- endfor %}
        {% else %}
          <a class="capitalize hover:text-[var(--footer-accent)] hover:underline" href="{{ brand_profile_url }}"
            >Brand profile</a
          >
          <a class="capitalize hover:text-[var(--footer-accent)] hover:underline" href="{{ about_us_url }}">About us</a>
          <a class="capitalize hover:text-[var(--footer-accent)] hover:underline" href="{{ outlets_url }}"
            >Outlet location</a
          >
          <a class="capitalize hover:text-[var(--footer-accent)] hover:underline" href="{{ contact_url }}"
            >Contact us</a
          >
        {% endif %}
      </nav>

      <nav class="flex flex-col items-center gap-2 sm:items-start" aria-labelledby="FooterPolicies-{{ section.id }}">
        <h2
          id="FooterPolicies-{{ section.id }}"
          class="mb-1 text-lg font-bold capitalize text-gray-600 underline underline-offset-4"
        >
          {{ section.settings.policies_heading | escape }}
        </h2>
        {% if section.settings.policies_menu != blank %}
          {% for link in section.settings.policies_menu.links -%}
            <a class="capitalize hover:text-[var(--footer-accent)] hover:underline" href="{{ link.url }}">
              {{- link.title -}}
            </a>
          {%- endfor %}
        {% else %}
          <a class="capitalize hover:text-[var(--footer-accent)] hover:underline" href="{{ privacy_url }}"
            >Privacy policy</a
          >
          <a class="capitalize hover:text-[var(--footer-accent)] hover:underline" href="{{ terms_url }}"
            >Terms and conditions</a
          >
        {% endif %}
      </nav>

      <nav class="flex flex-col items-center gap-2 sm:items-start" aria-labelledby="FooterHelp-{{ section.id }}">
        <h2
          id="FooterHelp-{{ section.id }}"
          class="mb-1 text-lg font-bold capitalize text-gray-600 underline underline-offset-4"
        >
          {{ section.settings.help_heading | escape }}
        </h2>
        {% if section.settings.help_menu != blank %}
          {% for link in section.settings.help_menu.links -%}
            <a class="capitalize hover:text-[var(--footer-accent)] hover:underline" href="{{ link.url }}">
              {{- link.title -}}
            </a>
          {%- endfor %}
        {% else %}
          <a class="capitalize hover:text-[var(--footer-accent)] hover:underline" href="{{ shipping_url }}"
            >Shipping policy</a
          >
          <a class="capitalize hover:text-[var(--footer-accent)] hover:underline" href="{{ refund_url }}"
            >Exchange policy</a
          >
        {% endif %}
      </nav>
    </div>

    {% if section.settings.social_facebook_url != blank
      or section.settings.social_instagram_url != blank
      or section.settings.social_youtube_url != blank
    %}
      <div class="flex flex-col items-center">
        <h2 class="m-0 text-center text-lg font-bold uppercase text-gray-800 sm:text-xl">
          {{ section.settings.social_heading | escape }}
        </h2>
        <div class="mt-4 flex items-center justify-center gap-5">
          {% if section.settings.social_facebook_url != blank %}
            <a
              class="grid size-10 place-items-center rounded-full transition hover:scale-110 hover:bg-white/70 hover:text-[var(--footer-accent)]"
              href="{{ section.settings.social_facebook_url }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
            >
              <svg class="size-6 fill-current" aria-hidden="true" viewBox="0 0 24 24">
                <path d="M9 8H6v4h3v12h5V12h3.64L18 8h-4V6.33C14 5.38 14.19 5 15.12 5H18V0h-3.81C10.6 0 9 1.58 9 4.62V8Z"/>
              </svg>
            </a>
          {% endif %}
          {% if section.settings.social_instagram_url != blank %}
            <a
              class="grid size-10 place-items-center rounded-full transition hover:scale-110 hover:bg-white/70 hover:text-[var(--footer-accent)]"
              href="{{ section.settings.social_instagram_url }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
            >
              <svg class="size-6 fill-current" aria-hidden="true" viewBox="0 0 24 24">
                <path d="M7.8 2h8.4A5.8 5.8 0 0 1 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8A5.8 5.8 0 0 1 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2Zm-.2 2A3.6 3.6 0 0 0 4 7.6v8.8A3.6 3.6 0 0 0 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6A3.6 3.6 0 0 0 16.4 4H7.6Zm9.65 1.5a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z"/>
              </svg>
            </a>
          {% endif %}
          {% if section.settings.social_youtube_url != blank %}
            <a
              class="grid size-10 place-items-center rounded-full transition hover:scale-110 hover:bg-white/70 hover:text-[var(--footer-accent)]"
              href="{{ section.settings.social_youtube_url }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="YouTube"
            >
              <svg class="size-7 fill-current" aria-hidden="true" viewBox="0 0 24 24">
                <path d="M19.62 3.18c-3.6-.24-11.63-.24-15.24 0C.48 3.45.03 5.8 0 12c.03 6.19.48 8.55 4.38 8.82 3.61.24 11.64.24 15.24 0C23.52 20.55 23.97 18.2 24 12c-.03-6.19-.48-8.55-4.38-8.82ZM9 16V8l8 4-8 4Z"/>
              </svg>
            </a>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>

  <div class="bg-[var(--footer-accent)] px-5 py-4 text-center text-xs capitalize leading-6 text-white sm:text-sm">
    <p class="m-0">
      © {{ 'now' | date: '%Y' }} — All rights reserved by {{ section.settings.copyright_owner | escape }}
      {% if section.settings.developer_name != blank %}
        <span aria-hidden="true"> | </span>Designed &amp; developed by
        {% if section.settings.developer_url != blank -%}
          <a
            class="font-semibold underline-offset-2 hover:underline"
            href="{{ section.settings.developer_url }}"
            target="_blank"
            rel="noopener noreferrer"
          >
            {{- section.settings.developer_name | escape -}}
          </a>
        {%- else -%}
          {{- section.settings.developer_name | escape -}}
        {%- endif %}
      {% endif %}
      <span aria-hidden="true"> | </span
      ><a class="hover:underline" href="{{ privacy_url }}">Privacy policy &amp; cookies</a>
      <span aria-hidden="true"> | </span><a class="hover:underline" href="{{ terms_url }}">Terms &amp; conditions</a>
    </p>
  </div>
</footer>

{% schema %}
{
  "name": "Deshal footer",
  "settings": [
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Brand statement",
      "default": "Handcrafted ethnic luxury clothing inspired by Bengali nostalgia and mythology"
    },
    { "type": "image_picker", "id": "background_image", "label": "Background pattern" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#7d1717" },
    { "type": "header", "content": "Menu columns" },
    { "type": "text", "id": "about_heading", "label": "First column heading", "default": "About us" },
    { "type": "link_list", "id": "about_menu", "label": "First column menu" },
    { "type": "url", "id": "brand_profile_url", "label": "Brand profile page" },
    { "type": "url", "id": "about_us_url", "label": "About us page" },
    { "type": "url", "id": "outlets_url", "label": "Outlets page" },
    { "type": "url", "id": "contact_url", "label": "Contact page" },
    { "type": "text", "id": "policies_heading", "label": "Second column heading", "default": "Policies" },
    { "type": "link_list", "id": "policies_menu", "label": "Second column menu" },
    { "type": "text", "id": "help_heading", "label": "Third column heading", "default": "Policies" },
    { "type": "link_list", "id": "help_menu", "label": "Third column menu" },
    { "type": "header", "content": "Social media" },
    { "type": "text", "id": "social_heading", "label": "Social heading", "default": "Follow us for latest updates" },
    { "type": "url", "id": "social_facebook_url", "label": "Facebook URL" },
    { "type": "url", "id": "social_instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "social_youtube_url", "label": "YouTube URL" },
    { "type": "header", "content": "Copyright" },
    { "type": "text", "id": "copyright_owner", "label": "Copyright owner", "default": "Deshal" },
    { "type": "text", "id": "developer_name", "label": "Developer name", "default": "Team Zoetrone" },
    { "type": "url", "id": "developer_url", "label": "Developer URL" }
  ],
  "presets": [{ "name": "Deshal footer" }]
}
{% endschema %}
