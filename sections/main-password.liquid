{%- comment -%}
  Storefront password page.

  Rendered inside layout/password.liquid while the store is password protected.
  `storefront_password` is the only form Shopify accepts here; the merchant link
  at the bottom goes to the admin login, not a customer account.
{%- endcomment -%}

<section
  class="grid min-h-screen place-items-center px-4 py-16"
  style="--password-accent: {{ section.settings.accent_color }}"
>
  <div class="w-full max-w-md">
    <div class="text-center">
      {%- if settings.logo != blank -%}
        {{
          settings.logo
          | image_url: width: 400
          | image_tag: class: 'mx-auto h-auto w-40 object-contain', width: 160, alt: shop.name, loading: 'eager'
        }}
      {%- else -%}
        <img
          class="mx-auto h-auto w-40 object-contain"
          src="{{ 'DeshalMain.png' | asset_url }}"
          width="160"
          height="64"
          alt="{{ shop.name | escape }}"
        >
      {%- endif -%}

      <h1 class="mt-7 text-3xl font-bold uppercase text-[var(--password-accent)] sm:text-4xl">
        {{ section.settings.heading | escape }}
      </h1>
      {%- if section.settings.message != blank -%}
        <div class="mt-3 leading-7 text-gray-600 [&_p]:m-0">{{ section.settings.message }}</div>
      {%- endif -%}
    </div>

    <div class="mt-9 rounded-md bg-white p-6 shadow-xl sm:p-8">
      <h2 class="text-center text-lg font-semibold uppercase">Enter store using password</h2>

      {%- form 'storefront_password', class: 'mt-6 space-y-4' -%}
        {%- if form.errors -%}
          <div class="border border-red-200 bg-red-50 p-4 text-sm text-red-700" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div>
          <label class="mb-2 block text-sm font-medium" for="StorefrontPassword">Password</label>
          <input
            class="h-12 w-full border border-gray-300 px-4 outline-none focus:border-[var(--password-accent)]"
            id="StorefrontPassword"
            name="password"
            type="password"
            autocomplete="current-password"
            autofocus
            required
          >
        </div>

        <button
          class="h-12 w-full cursor-pointer border-0 bg-[var(--password-accent)] font-semibold uppercase text-white hover:brightness-110"
          type="submit"
        >
          Enter
        </button>
      {%- endform -%}
    </div>

    <p class="mt-8 text-center text-sm text-gray-500">
      Are you the store owner?
      <a class="font-semibold text-[var(--password-accent)] underline" href="{{ shop.url }}/admin">Log in here</a>
    </p>
    <p class="mt-2 text-center text-xs text-gray-400">
      &copy; {{ 'now' | date: '%Y' }}
      {{ shop.name | escape }}
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" },
    {
      "type": "richtext",
      "id": "message",
      "label": "Message",
      "default": "<p>We are putting the finishing touches on our new store. Please check back shortly.</p>"
    },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#7d1717" }
  ]
}
{% endschema %}
